[Unit]
Description=RD-2 PRISM crawler (checkpoint-resume)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rd2
WorkingDirectory=/opt/rd2
ExecStart=/opt/rd2/.venv/bin/python scripts/collect_prism.py --db rd2_prod.db --count 8000
Restart=on-failure
RestartSec=30
# collect_prism.py 자체가 <db경로>.prism_checkpoint.json으로 진행 상황을 저장하므로
# (scripts/collect_prism.py 참고) 재시작해도 처음부터 다시 돌지 않고 이어서 진행한다.

[Install]
WantedBy=multi-user.target
