# 복사해서 .env로 저장하고 실제 키를 채워넣으세요 (.env는 git에 커밋되지 않습니다)
OPENAI_API_KEY=

# MariaDB 접속정보 (로컬 개발: localhost, EC2 배포 시 RDS 엔드포인트로 교체)
MARIADB_HOST=
MARIADB_PORT=3306
MARIADB_USER=
MARIADB_PASSWORD=
MARIADB_DATABASE=

# 선택사항: 첨부파일 저장 루트. 생략하면 저장소 루트의 data/를 사용한다.
# 기존 EC2 파일을 재사용할 때 예: RD2_FILES_ROOT=/home/ubuntu/data
# RD2_FILES_ROOT=
